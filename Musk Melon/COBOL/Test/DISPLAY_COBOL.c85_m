001000$SET LIST                                                                     
002000 IDENTIFICATION DIVISION.                                                     
003000  PROGRAM-ID.               HELLO.                                            
004000*                                                                             
005000*****************************************************************             
006000*  PROGRAM : HELLO                                              *             
007000*  PURPOSE : Minimal demo - writes 10 DISPLAY lines to the log. *             
008000*  CALLED  : Run from HELLOJOB.WFL                              *             
009000*            RUN (PANDASUB)OBJECT/HELLO.                        *             
010000*****************************************************************             
011000*                                                                             
012000 ENVIRONMENT DIVISION.                                                        
013000  CONFIGURATION SECTION.                                                      
014000   SOURCE-COMPUTER.         A-SERIES.                                         
015000   OBJECT-COMPUTER.         A-SERIES.                                         
016000*                                                                             
017000 DATA DIVISION.                                                               
018000 WORKING-STORAGE SECTION.                                                     
019000 01  WS-PROGRAM-NAME          PIC X(010) VALUE "HELLO".                       
020000 01  WS-COUNT                 PIC 9(002) VALUE 0.                             
021000*                                                                             
022000 PROCEDURE DIVISION.                                                          
023000*                                                                             
024000 S0000-MAIN SECTION.                                                          
025000  P0000-MAIN.                                                                 
026000     DISPLAY "HELLO: LINE 01 - PROGRAM STARTED".                              
027000     DISPLAY "HELLO: LINE 02 - HELLO FROM COBOL ON MCP".                      
028000     DISPLAY "HELLO: LINE 03 - THIS PROGRAM WAS CALLED BY WFL".               
029000     DISPLAY "HELLO: LINE 04 -DISPLAY OUTPUT GOES TO THE JOB LOG".            
030000     DISPLAY "HELLO: LINE 05 - PROGRAM NAME = " WS-PROGRAM-NAME.              
031000     MOVE 6                   TO WS-COUNT.                                    
032000     DISPLAY "HELLO: LINE 06 - COUNT VALUE = " WS-COUNT.                      
033000     DISPLAY "HELLO: LINE 07 - STEP SEVEN REACHED".                           
034000     DISPLAY "HELLO: LINE 08 - ALMOST DONE".                                  
035000     DISPLAY "HELLO: LINE 09 - CLOSING DOWN".                                 
036000     DISPLAY "HELLO: LINE 10 - PROGRAM ENDED".                                
037000     STOP RUN.                                                                
038000  P0000-EXIT. EXIT.                                                           
