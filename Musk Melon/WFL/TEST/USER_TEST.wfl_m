?BEGIN JOB HELLOJOB;                                                              00001000
%                                                                                 00002000
% ================================================================                00003000
% JOB  : HELLOJOB                                                                 00004000
% DESC : Simple WFL that runs the COBOL program HELLO.                            00005000
%        HELLO writes 10 DISPLAY lines to the job log.                            00006000
% OBJECT: (PANDASUB)OBJECT/HELLO                                                  00007000
% ================================================================                00008000
%                                                                                 00009000
  TASK RUNOK;                                                                     00010000
                                                                                  00011000
  DISPLAY "HELLOJOB: STARTING - ABOUT TO RUN HELLO";                              00012000
                                                                                  00013000
  RUN (PANDASUB)OBJECT/HELLO [RUNOK];                                             00014000
                                                                                  00015000
  IF RUNOK IS COMPLETEDOK THEN                                                    00016000
    DISPLAY "HELLOJOB: HELLO COMPLETED OK"                                        00017000
  ELSE                                                                            00018000
    BEGIN                                                                         00019000
      DISPLAY "HELLOJOB: HELLO FAILED";                                           00020000
      ABORT "HELLOJOB - RUN FAILED";                                              00021000
    END;                                                                          00022000
                                                                                  00023000
  DISPLAY "HELLOJOB: JOB COMPLETED";                                              00024000
                                                                                  00025000
?END JOB.                                                                         00026000
